#!/bin/bash
# pre-push: refuse to publish anything that belongs to the private overlay.
#
# For every pushed ref, over the commits the push target does not have yet, three things are read:
#   1. every line those commits add (git log -p -U0 --text --no-renames, the "+" lines),
#   2. their commit messages, plus the message of every annotated tag pushed,
#   3. the paths they touch, plus every path in the pushed tip tree.
# The texts to look for come from the overlay (overlay/leak-terms prints them), so this public
# file names nothing the overlay adds. Each printed line is tab separated:
#   id     <text>         case-sensitive substring
#   word   <text>         case-insensitive substring
#   path   <path>         a file only the overlay has; a pushed path equal to it is refused
#   dir    <dir>          a directory only the overlay has; a pushed path under it is refused
#   allow  <ERE>  <a|b>   hits of exactly those texts in files whose path matches the ERE pass;
#                         commit and tag messages are matched under the path COMMIT_MSG
#
# The scan is required when the main checkout has an overlay link, or when
# `git config tally.leakguard` is "required" (scripts/hooks/install.sh --required). Required means a
# missing, failing or short term list refuses the push. A contributor's clone has neither, so only
# the generic overlay/ path check runs there and the push goes through.
#
# Published history is never rescanned: for a new ref, what the target already has is read from the
# target itself (git ls-remote on the URL git pushes to), never from local tracking refs.
#
# Known limits:
#   - A push to an empty or new repository scans the whole history, so an already published commit
#     that carries a term refuses it (fail-closed).
#   - A path git has to quote (quotes, control characters) matches no allow line, so its hits are
#     refused (fail-closed).
#   - Ref names themselves (a branch or lightweight tag name) are not scanned.
set -uo pipefail
# Byte-wise matching: BSD awk aborts on bytes that are not valid UTF-8 under a UTF-8 locale.
export LC_ALL=C
# $2 is the URL git pushes to, after pushurl and url.*.pushInsteadOf; $1 (the remote name) is not used.
url="$2"
ZERO=0000000000000000000000000000000000000000
fail() { echo "pre-push: $*" >&2; exit 1; }

common=$(git rev-parse --path-format=absolute --git-common-dir) || fail "cannot locate the git dir (fail-closed)"
root=$(dirname "$common")
overlay="$root/overlay"
required=0
if [ -e "$overlay" ] || [ -L "$overlay" ]; then required=1; fi
if [ "$(git config --get tally.leakguard || true)" = required ]; then required=1; fi

work=$(mktemp -d) || fail "mktemp failed (fail-closed)"
trap 'rm -rf "$work"' EXIT
: > "$work/terms"
if [ "$required" = 1 ]; then
  gen="$overlay/leak-terms"
  [ -x "$gen" ] || fail "leak scan is required here but $gen is missing (fail-closed)"
  "$gen" "$root" > "$work/terms" || fail "leak term generator failed (fail-closed)"
  # A short list means the generator lost a source; refuse rather than scan with part of it.
  for floor in id:20 path:20 word:1; do
    n=$(command grep -c "^${floor%%:*}	" "$work/terms") || true
    [ "${n:-0}" -ge "${floor#*:}" ] || fail "leak term list has ${n:-0} ${floor%%:*} lines (fail-closed)"
  done
fi

# Separates commits in the generated listings; random per run, so no message or content can forge it.
mark="@@@$(od -An -tx1 -N16 /dev/urandom | tr -d ' \n') "
[ ${#mark} = 36 ] || fail "cannot generate a separator (fail-closed)"

# The tips the push target already has, kept as "^sha" lines when this clone has them as commits:
# the boundary for a new ref. A tip this clone lacks (pushed by someone else) bounds nothing here.
boundary() {
  [ -e "$work/known" ] && return
  git ls-remote "$url" > "$work/tips" 2> /dev/null || fail "cannot list $url (fail-closed)"
  cut -f1 "$work/tips" | sort -u | git cat-file --batch-check='%(objectname) %(objecttype)' > "$work/types" \
    || fail "cannot check the tips of $url (fail-closed)"
  awk '$2 == "commit" { print "^" $1 }' "$work/types" > "$work/known" || fail "boundary failed (fail-closed)"
}

cat > "$work/scan.awk" <<'AWK'
function allowed(f, t,   i) {
  for (i = 1; i <= na; i++) if (f ~ are[i] && index(aterms[i], "|" t "|") > 0) return 1
  return 0
}
function hit(f, sha, s) { print ref "\t" sha "\t" f "\t" substr(s, 1, 160) }
function scan(f, sha, s,   i, low) {
  for (i = 1; i <= nid; i++) if (index(s, idt[i]) > 0 && !allowed(f, idt[i])) { hit(f, sha, s); return }
  low = tolower(s)
  for (i = 1; i <= nw; i++) if (index(low, wt[i]) > 0 && !allowed(f, wt[i])) { hit(f, sha, s); return }
}
FILENAME == ARGV[1] {
  if ($1 == "id") idt[++nid] = $2
  else if ($1 == "word") wt[++nw] = tolower($2)
  else if ($1 == "path") opath[$2] = 1
  else if ($1 == "dir") odir[++nd] = $2 "/"
  else if ($1 == "allow") { are[++na] = $2; aterms[na] = "|" $3 "|" }
  next
}
# Both listings start each commit with the separator line.
(FILENAME == ARGV[2] || FILENAME == ARGV[3]) && mark != "" && index($0, mark) == 1 { sha = substr($0, length(mark) + 1); next }
FILENAME == ARGV[2] {
  # "+++ " names the file only in a diff header; inside a hunk an added "++ x" line prints the same.
  if (index($0, "diff --git ") == 1) { inhdr = 1; next }
  if (index($0, "@@ ") == 1) { inhdr = 0; next }
  if (inhdr && index($0, "+++ ") == 1) { file = substr($0, 5); sub(/^b\//, "", file); next }
  if (index($0, "+") == 1) scan(file, sha, substr($0, 2))
  next
}
FILENAME == ARGV[3] {
  scan("COMMIT_MSG", sha, $0)
  next
}
$0 != "" {
  if (index($0, "overlay/") == 1) { hit($0, "-", "path under overlay/"); next }
  if ($0 in opath) { hit($0, "-", "private path"); next }
  for (i = 1; i <= nd; i++) if (index($0, odir[i]) == 1) { hit($0, "-", "private directory"); next }
  scan($0, "-", $0)
}
AWK

: > "$work/hits"
while read -r lref lsha rref rsha; do
  [ "$lsha" = "$ZERO" ] && continue
  if [ "$rsha" != "$ZERO" ]; then
    echo "$rsha..$lsha" > "$work/revs"
  else
    boundary; { echo "$lsha"; cat "$work/known"; } > "$work/revs"
  fi
  # first-parent diffs show what a merge adds, including text written while resolving a conflict;
  # --no-renames and --text keep renamed and binary content in the "+" lines.
  # BSD awk ends a line at a NUL byte, so every git output it reads has NUL turned into a space.
  git -c core.quotepath=off log -p -U0 --diff-merges=first-parent --no-renames --text --no-color --no-ext-diff \
    --no-textconv --format="$mark%h" --stdin < "$work/revs" | tr '\000' ' ' > "$work/patch" || fail "git log -p failed for $lref (fail-closed)"
  git log --format="$mark%h%n%B" --stdin < "$work/revs" | tr '\000' ' ' > "$work/msgs" || fail "git log failed for $lref (fail-closed)"
  # An annotated tag (or a chain of them) carries a message of its own.
  obj=$lsha
  while [ "$(git cat-file -t "$obj")" = tag ]; do
    git cat-file tag "$obj" > "$work/tag" || fail "cannot read tag $obj (fail-closed)"
    { echo "$mark$(git rev-parse --short "$obj")"; tr '\000' ' ' < "$work/tag"; } >> "$work/msgs"
    obj=$(awk 'NR == 1 { print $2 }' "$work/tag")
  done
  { git -c core.quotepath=off log --format= --name-only --no-renames --diff-merges=first-parent --stdin < "$work/revs" \
      && git -c core.quotepath=off ls-tree -r --name-only "$lsha"; } > "$work/paths" \
    || fail "path listing failed for $lref (fail-closed)"
  awk -F'\t' -v ref="$lref" -v mark="$mark" -f "$work/scan.awk" "$work/terms" "$work/patch" "$work/msgs" "$work/paths" \
    >> "$work/hits" || fail "scan failed for $lref (fail-closed)"
done

if [ -s "$work/hits" ]; then
  total=$(sort -u "$work/hits" | wc -l | tr -d ' ')
  echo "pre-push: refusing to publish; $total lines carry private overlay terms or paths (first 10):" >&2
  sort -u "$work/hits" | head -10 >&2
  exit 1
fi
exit 0
