    },
    "Tally will move this account's config folder to the Trash:": {
      "extractionState": "manual",
      "localizations": {
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "Tally 會把這個帳號的設定資料夾移到垃圾桶："
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
