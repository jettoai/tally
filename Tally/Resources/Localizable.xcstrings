    "Move to Trash": {
      "extractionState": "manual",
      "localizations": {
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "移到垃圾桶"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
