    },
    "Could not be linked, so the shared setup is incomplete:": {
      "extractionState": "manual",
      "localizations": {
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "無法建立連結，共享的設定並不完整："
          }
