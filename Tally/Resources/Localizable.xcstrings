          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "여기에는 탭 자동완성이 없습니다. 직접 추가하려면: [[ -e \"${fpath[1]}/_tally\" ]] || tally completion zsh > \"${fpath[1]}/_tally\""
          }
        }
      }
    },
