          }
        }
      }
    },
    "Tally creates the next config home and opens the provider's sign-in in your browser.": {
      "extractionState": "manual",
      "localizations": {
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "Tally 會建立下一個設定目錄，並在瀏覽器開啟該供應商的登入頁。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "Tally 会创建下一个配置目录，并在浏览器中打开该服务商的登录页。"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "Tally が次の設定ディレクトリを作成し、プロバイダのサインインをブラウザで開きます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "Tally가 다음 설정 디렉터리를 만들고 브라우저에서 제공업체 로그인을 엽니다."
          }
        }
      }
    },
    "The config home is waiting: reopen Add account in Settings to finish the sign-in.": {
      "extractionState": "manual",
      "localizations": {
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "設定家目錄已就緒：回到設定的「新增帳號」即可完成登入。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "配置主目录已就绪：回到设置的“添加账号”即可完成登录。"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "設定ホームは用意できています。設定の「アカウントを追加」からサインインを完了してください。"
          }
